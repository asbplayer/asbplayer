{
    "name": "root",
    "private": true,
    "license": "AGPL-3.0-or-later",
    "devDependencies": {
        "@eslint/js": "^9.32.0",
        "@typescript-eslint/parser": "^8.38.0",
        "eslint": "^9.32.0",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^5.2.0",
        "globals": "^14.0.0",
        "prettier": "^3.6.2",
        "typescript": "catalog:",
        "typescript-eslint": "^8.59.1"
    },
    "devEngines": {
        "packageManager": {
            "name": "pnpm",
            "version": "11.27.0",
            "onFail": "error"
        }
    },
    "scripts": {
        "sync:project": "node --experimental-strip-types scripts/sync-project-config.ts",
        "check:project": "pnpm run check:ffmpeg-version && node --experimental-strip-types scripts/sync-project-config.ts --check",
        "check:ffmpeg-version": "node --experimental-strip-types scripts/check-ffmpeg-version.ts",
        "check:contributors": "node --experimental-strip-types scripts/check-contributors.ts",
        "test:scripts": "node --test --experimental-strip-types scripts/*.test.ts",
        "verify": "pnpm run verify:app && pnpm --filter @project/ffmpeg run verify:code",
        "verify:app": "pnpm run check:project && scripts/loc/loc-keys-match && scripts/loc/loc-codes-in-extension-config && scripts/page-file-references-are-correct && pnpm --filter @project/common run typecheck && pnpm --filter @project/common run test && pnpm --filter @project/client run test && pnpm --filter @project/extension run test && pnpm eslint common extension/src client/src && pnpm run test:scripts && pnpm run pretty:check",
        "pretty": "pnpm prettier --write './(client|common|extension|ffmpeg)/**/*.(js|mjs|cjs|ts|tsx|css)' './scripts/*.ts'",
        "pretty:check": "pnpm prettier --check './(client|common|extension|ffmpeg)/**/*.(js|mjs|cjs|ts|tsx|css)' './scripts/*.ts'"
    }
}
