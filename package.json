{
    "name": "root",
    "private": true,
    "devDependencies": {
        "@eslint/js": "^9.32.0",
        "@typescript-eslint/parser": "^8.38.0",
        "eslint": "^9.32.0",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^5.2.0",
        "prettier": "^3.6.2",
        "typescript": "^5.8.3",
        "typescript-eslint": "^8.59.1"
    },
    "engines": {
        "node": ">=24.19.0"
    },
    "devEngines": {
        "packageManager": {
            "name": "pnpm",
            "version": "11.21.0",
            "onFail": "error"
        }
    },
    "scripts": {
        "verify": "scripts/loc/loc-keys-match && scripts/loc/loc-codes-in-extension-config && scripts/page-file-references-are-correct && pnpm --filter @project/common run test && pnpm --filter @project/client run test && pnpm --filter @project/extension run test && pnpm run eslint common extension/src client/src && pnpm run pretty:check",
        "pretty": "pnpm prettier --write './(client|common|extension)/**/*.(js|ts|tsx|css)'",
        "pretty:check": "pnpm prettier --check './(client|common|extension)/**/*.(js|ts|tsx|css)'"
    }
}
