#!/bin/bash
set -euo pipefail

source "$(dirname -- "${BASH_SOURCE[0]}")/config"

if [ -z "${1:-}" ]; then
    echo "usage: $0 <timestamp> [mediaId]"
    exit 1
fi

if [ -z "${2:-}" ]; then
    body='{"timestamp": '$1'}'
else
    body='{"timestamp": '$1', "mediaId": "'$2'"}'
fi

curl -H "content-type: application/json" \
    -X POST "$ASBPLAYER_SERVER_URL/asbplayer/seek" \
    -d "$body"
