#!/bin/bash
set -euo pipefail

source "$(dirname -- "${BASH_SOURCE[0]}")/config"

MEDIA_ID="${1:-}"
TRACK_NUMBERS="${2:-}"

QUERY=""
[ -n "$MEDIA_ID" ] && QUERY="mediaId=$MEDIA_ID"
[ -n "$TRACK_NUMBERS" ] && QUERY="${QUERY:+$QUERY&}trackNumbers=$TRACK_NUMBERS"

curl -H "content-type: application/json" \
    -X GET "$ASBPLAYER_SERVER_URL/asbplayer/subtitles${QUERY:+?$QUERY}"
