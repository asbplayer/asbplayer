#!/bin/bash
set -euo pipefail

function json_to_csv() {
    jq -r '[paths(scalars) as $path | {"key": $path | join("."), "value": getpath($path)}] | .[] | "\"\(.key)\",\"\",\"\",\"\(.value)\""' $1
}
mkdir -p csv
SCRIPTPATH="$(cd -- "$(dirname "$0")" >/dev/null 2>&1; pwd -P)"
while IFS= read -r locale; do
    echo "Key,Notes,English,Translation" >> csv/$locale.csv
    json_to_csv "$SCRIPTPATH/../../common/locales/$locale.json" >> csv/$locale.csv
    json_to_csv "$SCRIPTPATH/../../extension/public/_locales/$locale/messages.json" >> csv/$locale.csv
done < <(jq -r '.languages[].code' "$SCRIPTPATH/../../project.json")
